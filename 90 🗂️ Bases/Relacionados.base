filters:
  and:
    - file.hasLink(this.file)
properties:
  note.episodio:
    displayName: EP
  note.data:
    displayName: Data
  note.categoria:
    displayName: Categoria
  note.raridade:
    displayName: Raridade
  note.canal:
    displayName: Canal
  note.mensagens:
    displayName: Mensagens
views:
  - type: cards
    name: Episódios
    filters:
      and:
        - tipo == "sessao"
    order:
      - file.name
      - data
    sort:
      - property: episodio
        direction: ASC
    image: note.imagem
    imageFit: cover
  - type: cards
    name: Equipamentos
    filters:
      and:
        - tipo == "item" || tipo == "invocacao"
    order:
      - file.name
      - raridade
      - categoria
    sort:
      - property: file.name
        direction: ASC
    image: note.imagem
    imageFit: cover
  - type: cards
    name: Pessoas e lugares
    filters:
      and:
        - tipo == "npc" || tipo == "companheiro" || tipo == "personagem" || tipo == "lore" || tipo == "aspecto" || tipo == "espirito" || tipo == "inimigo"
    order:
      - file.name
      - categoria
    sort:
      - property: file.name
        direction: ASC
    image: note.imagem
    imageFit: cover
  - type: table
    name: Registros
    filters:
      and:
        - tipo == "canal"
    order:
      - file.name
      - canal
      - mensagens
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Tudo
    groupBy:
      property: tipo
      direction: ASC
    order:
      - file.name
      - categoria
    sort:
      - property: file.name
        direction: ASC
